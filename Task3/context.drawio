        <mxCell id="devices" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Устройства умного дома&lt;/b&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:11px;color:#cccccc&quot;&gt;Домофоны и шлагбаумы на объектах недвижимости&lt;/div&gt;" vertex="1">
